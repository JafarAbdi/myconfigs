    opencode)
        TMP_DIR=$(mktemp -d -p /tmp install-XXXXXX)
        pushd "$TMP_DIR" || exit 1
        oc_target="linux-${oc_arch}"
        if [ "$oc_arch" = "x64" ] && ! grep -qi avx2 /proc/cpuinfo 2>/dev/null; then
            oc_target="${oc_target}-baseline"
        fi
        if command -v ldd >/dev/null 2>&1 && ldd --version 2>&1 | grep -qi musl; then
            oc_target="${oc_target}-musl"
        fi
        wget "https://github.com/anomalyco/opencode/releases/latest/download/opencode-${oc_target}.tar.gz"
        tar xzf "opencode-${oc_target}.tar.gz"
        mv opencode ~/.local/bin/opencode
        chmod +x ~/.local/bin/opencode
        popd || exit 1
        ;;

    codium)
        TMP_DIR=$(mktemp -d -p /tmp install-XXXXXX)
        pushd "$TMP_DIR" || exit 1
        case "$arch" in
          x86_64|amd64)
            codium_arch="x64"
            ;;
          aarch64|arm64)
            codium_arch="arm64"
            ;;
          *)
            error "Unsupported architecture: $arch"
            ;;
        esac
        codium_version=$(curl -s https://api.github.com/repos/VSCodium/vscodium/releases/latest | grep -oP '"tag_name": "\K[^"]+')
        wget "https://github.com/VSCodium/vscodium/releases/download/${codium_version}/VSCodium-linux-${codium_arch}-${codium_version}.tar.gz"
        (
          test -d ~/.vscodium && rm -rf ~/.vscodium || true
        ) && mkdir -p ~/.vscodium
        tar xzvf VSCodium-linux-${codium_arch}-${codium_version}.tar.gz -C ~/.vscodium
        popd || exit 1
        ;;

    github-ssh-keys)
        read -p "Enter email associated with github account: " email
        ssh-keygen -t rsa -b 4096 -C $email

        # Adding your SSH key to the ssh-agent
        eval $(ssh-agent -s)
        mkdir -p ~/.ssh
        ssh-add ~/.ssh/id_rsa

        xclip -sel clip < ~/.ssh/id_rsa.pub # Linux
        open https://github.com/settings/ssh
        ;;

    nodejs)
        if [ -z "${2:-}" ]; then
            error "nodejs requires a version argument. Usage: $0 nodejs <version>"
        fi
        # --skip-shell: fnm's installer `tee -a`'s its init block into
        # conf.d/fnm.fish with no idempotency check, so we write it ourselves.
        curl -o- https://fnm.vercel.app/install | bash -s -- --skip-shell
        ~/.local/share/fnm/fnm install "$2"
        # `default` alias backs ~/.local/share/fnm/aliases/default/bin, which
        # .xprofile puts on PATH so GDM/i3-launched apps find node & npm globals.
        ~/.local/share/fnm/fnm alias "$2" default
        if command -v fish >/dev/null 2>&1; then
            mkdir -p ~/.config/fish/conf.d
            cat > ~/.config/fish/conf.d/fnm.fish <<'EOF'
# fnm
set FNM_PATH "$HOME/.local/share/fnm"
if test -d "$FNM_PATH"
    set -gx PATH "$FNM_PATH" $PATH
    fnm env --shell fish | source
end
EOF
        fi
        curl -fsSL https://get.pnpm.io/install.sh | sh -
        ;;

    mc)
       wget https://dl.min.io/client/mc/release/linux-$arch_name/mc -O ~/.local/bin/mc
       chmod +x ~/.local/bin/mc
       ;;

    remote)
        if [ $# -lt 3 ]; then
            error "remote requires HOST and COMMAND. Usage: $0 remote <host> <command> [args...]"
        fi
        host="$2"
        shift 2
        # wezterm is pushed from the local store (not downloaded on the remote):
        # lazy -- only if missing -- and completion is generated on the remote from
        # the copied binary; only terminfo is shipped from the cache.
        if [ "$*" = "wezterm" ]; then
            if ssh -- "$host" 'test -x ~/.local/bin/wezterm || command -v wezterm >/dev/null 2>&1'; then
                info "wezterm present on $host, skipping"
                exit 0
            fi
            src=$(wezterm_store_path "$(ssh -- "$host" uname -m)")
            wezterm_terminfo
            info "pushing wezterm -> $host"
            ssh -- "$host" 'mkdir -p ~/.local/bin ~/.config/fish/completions ~/.terminfo'
            scp "$src" "$host:.local/bin/wezterm.new"
            scp "$WEZTERM_STORE/wezterm.terminfo" "$host:/tmp/wezterm.terminfo"
            ssh -- "$host" 'chmod +x ~/.local/bin/wezterm.new && mv -f ~/.local/bin/wezterm.new ~/.local/bin/wezterm \
                && ~/.local/bin/wezterm shell-completion --shell fish > ~/.config/fish/completions/wezterm.fish \
                && tic -x -o ~/.terminfo /tmp/wezterm.terminfo && rm -f /tmp/wezterm.terminfo'
            exit 0
        fi
        scp "$0" "$host:/tmp/myinstall"
        ssh -t "$host" "bash /tmp/myinstall $*; rm -f /tmp/myinstall"
        ;;

    pixi-core)
        info "Installing core tools..."
        pixi global install git git-lfs stow less file fish openssh ripgrep fd-find fzf bat nvim unzip tmux atool xclip pipe-rename tree-sitter-cli ast-grep witr

        pixi_path=${PIXI_PATH:-$HOME/.pixi}
        # https://pixi.sh/latest/global_tools/trampolines/#trampolines
        remove_conda_prefix "$pixi_path"/bin/trampoline_configuration/nvim.json
        remove_conda_prefix "$pixi_path"/bin/trampoline_configuration/tmux.json
        remove_conda_prefix "$pixi_path"/bin/trampoline_configuration/fish.json

        # Neovim inline preview tools (imgcat: LaTeX + mermaid rendering)
        $0 typst
        $0 mmdr
        ;;

    pixi-devtools)
        info "Installing dev tools..."
        pixi global install cmake ninja taplo stylua actionlint mergiraf luarocks platformio just prek # podman. Requires sudo apt install uidmap passt
        ~/.pixi/bin/just --completions fish > ~/.config/fish/completions/justfile.fish
        ;;

    pixi-build-rust)
