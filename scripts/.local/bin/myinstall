        KDENLIVE_VERSION=$(curl -sL "https://download.kde.org/stable/kdenlive/${KDENLIVE_MINOR}/linux/" | grep -oP 'kdenlive-\K[0-9]+\.[0-9]+\.[0-9]+(?=-x86_64\.AppImage)' | sort -V | tail -1)
