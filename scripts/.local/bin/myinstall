#!/usr/bin/env bash

set -euo pipefail

# Ensure pixi is in PATH for remote execution (SSH non-interactive shells don't source .bashrc)
[[ -d "$HOME/.pixi/bin" ]] && export PATH="$HOME/.pixi/bin:$PATH"

readonly RED='\033[0;31m'
readonly GREEN='\033[0;32m'
readonly YELLOW='\033[1;33m'
readonly NC='\033[0m' # No Color
readonly arch=$(uname -m)
case "$arch" in
  x86_64|amd64)
    arch_name="amd64"
    oc_arch="x64"
    ;;
  aarch64|arm64)
    arch_name="arm64"
    oc_arch="arm64"
    ;;
  *)
    arch_name="unknown"  # Handle other architectures if needed
    oc_arch="unknown"
    ;;
esac

extract() {
  atool -qx "$1"
}

error() {
    echo -e "${RED}Error: ${1}${NC}" >&2
    exit 1
}

warning() {
    echo -e "${YELLOW}Warning: ${1}${NC}" >&2
}

info() {
    echo -e "${GREEN}${1}${NC}"
}

install_package() {
    if command -v sudo >/dev/null 2>&1; then
        sudo apt-get install -y "$@"
    else
        warning "sudo is not available. Attempting to run apt-get without sudo."
        apt-get install -y "$@"
    fi
}

install_from_github() {
    if [ $# -ne 2 ]; then
        echo "install-from-github requires 2 inputs USER/REPO regex" >&2
        return 1
    fi
    curl -s "https://api.github.com/repos/$1/releases" \
      | grep -E "https://github.com/$1/releases/download.*$2" \
      | cut -d':' -f 2,3 \
      | tr -d \" \
      | head -n 1 \
      | wget -i -
}

remove_conda_prefix() {
    local file_path="$1"
    ~/.pixi/bin/pixi run --manifest-path ~/myconfigs/pixi.toml --frozen python -c """
import os
import json

# Load the JSON file
with open(\"${file_path}\", \"r\") as f:
    data = json.load(f)

# Remove all env variables
data[\"env\"] = {}

# Save back to file
with open(\"$file_path\", \"w\") as f:
    json.dump(data, f, indent=2)
"""
}

sync_to_remote() {
    local host="$1"
    local script_dir="$( cd "$( dirname "$(realpath "${BASH_SOURCE[0]}")" )" &> /dev/null && pwd )"
    local myconfigs_dir="$( cd "$script_dir/../../.." && pwd )"
    info "Syncing myconfigs to $host..."
    rsync -vuaSHAXhP \
        --exclude='.pixi' \
        --exclude='.git' \
        --exclude='.venv' \
        --exclude='node_modules' \
        --exclude='__pycache__' \
        --exclude='pi/.pi/agent/sessions' \
        "$myconfigs_dir/" "$host:~/myconfigs/"
}

list_options() {
    grep -E '^[[:space:]]+[a-zA-Z0-9_-]+\)' "$0" | sed 's/)//' | tr -d ' \t' | sort
}

# wezterm distribution store: source of truth for the wezterm binary + its
# completion/terminfo, keyed by arch. persistent (not ~/.cache, which cleaners
# prune). filled lazily from upstream on a miss; overwrite an entry with your own
# fork build to distribute that instead. see the wezterm/wezterm-build targets.
readonly WEZTERM_STORE="${XDG_DATA_HOME:-$HOME/.local/share}/wezterm/dist"

# arch -> upstream nightly release asset
wezterm_asset() {
    case "$1" in
        x86_64|amd64)  echo "WezTerm-nightly-Ubuntu20.04.AppImage" ;;
        aarch64|arm64) echo "wezterm-nightly.Ubuntu24.04.arm64.deb" ;;
        *) return 1 ;;
    esac
}

# echo path to a runnable wezterm binary for <arch> in the store. present -> keep
# (never re-pull); miss -> download upstream, normalize (.deb -> extract binary),
# save as wezterm-<arch>. `cp your.AppImage "$WEZTERM_STORE/wezterm-<arch>"` to
# distribute a fork build instead of upstream.
wezterm_store_path() {
    local a="$1" dst="$WEZTERM_STORE/wezterm-$1"
    if [ ! -s "$dst" ]; then
        local asset tmp
        asset=$(wezterm_asset "$a") || error "no upstream wezterm for arch: $a"
        mkdir -p "$WEZTERM_STORE"
        tmp=$(mktemp -d -p /tmp wezterm-XXXXXX)
        info "wezterm store miss: fetching $asset"
        wget -q "https://github.com/wez/wezterm/releases/download/nightly/$asset" -O "$tmp/$asset"
        case "$asset" in
            *.AppImage) install -m755 "$tmp/$asset" "$dst" ;;
            *.deb)      dpkg-deb -x "$tmp/$asset" "$tmp/x"; install -m755 "$tmp/x/usr/bin/wezterm" "$dst" ;;
        esac
        rm -rf "$tmp"
    fi
    echo "$dst"
}

# cache terminfo in the store (arch-independent data file) so installs don't hit
# GitHub each time. completion is NOT cached: it's generated on the fly from the
# placed binary (native, runs fine) -- see wezterm_finish and the remote push.
wezterm_terminfo() {
    mkdir -p "$WEZTERM_STORE"
    [ -s "$WEZTERM_STORE/wezterm.terminfo" ] \
        || curl -fsSL https://raw.githubusercontent.com/wez/wezterm/master/termwiz/data/wezterm.terminfo -o "$WEZTERM_STORE/wezterm.terminfo"
}

# completion + terminfo for a freshly-placed ~/.local/bin/wezterm; completion
# generated on the fly from that binary.
wezterm_finish() {
    mkdir -p ~/.config/fish/completions
    ~/.local/bin/wezterm shell-completion --shell fish > ~/.config/fish/completions/wezterm.fish
    wezterm_terminfo
    tic -x -o ~/.terminfo "$WEZTERM_STORE/wezterm.terminfo"
}

case "${1:-}" in
    core)
        install_package --no-install-recommends \
            parallel \
            python3-venv \
            fswatch \
            software-properties-common \
            python-is-python3 \
            ssh \
            colordiff \
            tree \
            less \
            lsb-release \
            iputils-ping \
            htop \
            python3-pip \
            python3-argcomplete \
            fuse3 \
            libfuse2 \
            p7zip-full \
            zip \
            wget \
            curl \
            file \
            lld \
            make \
            gcc \
            sshfs
        $0 minimal
        ;;

    minimal)
        mkdir -p ~/.local/bin || true
        install_package --no-install-recommends curl ca-certificates wget
        $0 pixi
        $0 pixi-core
        $0 stow
        $0 setup-fish
        $0 repgrep
        $0 uv
        ;;

    nextcloud-sync)
        TMP_DIR=$(mktemp -d -p /tmp install-XXXXXX)
        pushd "$TMP_DIR" || exit 1
        install_from_github nextcloud-releases/desktop "Nextcloud.*x86_64.AppImage"
        chmod +x Nextcloud*.AppImage
        mv Nextcloud*.AppImage ~/.local/bin/nextcloud
        popd || exit 1
        ;;

    i3)
        sudo apt install -y i3
        ;;

    docker-compose)
        TMP_DIR=$(mktemp -d -p /tmp install-XXXXXX)
        pushd "$TMP_DIR" || exit 1
        install_from_github docker/compose docker-compose-linux-x86_64
        chmod +x docker-compose-linux-x86_64
        mv docker-compose-linux-x86_64 ~/.local/bin/docker-compose
        popd || exit 1
        ;;

    mutagen)
        TMP_DIR=$(mktemp -d -p /tmp install-XXXXXX)
        pushd "$TMP_DIR" || exit 1
        install_from_github mutagen-io/mutagen "mutagen_linux_amd64_v.*\.tar\.gz"
        tar -xzf mutagen_linux_amd64_v*.tar.gz
        mv mutagen ~/.local/bin/mutagen
        mv mutagen-agents.tar.gz ~/.local/bin/mutagen-agents.tar.gz
        popd || exit 1
        ;;

    docker)
        if ! command -v docker &> /dev/null; then
            sudo apt install -y curl
            curl -sSL https://get.docker.com/ | sh
            sudo usermod -aG docker "$(whoami)"
            # newgrp docker
        fi
        $0 docker-compose
        sudo docker run hello-world
        # Nvidia
        # It uses the latest stable version, there's release for sid
        # https://docs.docker.com/engine/install/debian/
        # https://nickjanetakis.com/blog/docker-tip-77-installing-docker-on-debian-unstable
        info "To install nvidia-docker follow: https://docs.nvidia.com/datacenter/cloud-native/container-toolkit/latest/install-guide.html#installation"
        sudo systemctl restart docker
        mkdir -p ~/.bash_completion.d || true
        wget https://raw.githubusercontent.com/docker/cli/master/contrib/completion/bash/docker -O ~/.bash_completion.d/docker
        wget https://raw.githubusercontent.com/docker/compose/master/contrib/completion/bash/docker-compose -O ~/.bash_completion.d/docker-compose
        ;;


    repgrep)
        TMP_DIR=$(mktemp -d -p /tmp install-XXXXXX)
        pushd "$TMP_DIR" || exit 1
        if [ "$(uname -s)" = "Darwin" ]; then
            os="apple-darwin"
        else
            os="unknown-linux-gnu"
        fi
        install_from_github acheronfail/repgrep "repgrep.*$os.tar.gz"
        tar -xzf repgrep* --strip-components=1
        mv rgr ~/.local/bin
        if command -v fish >/dev/null 2>&1; then
          mv complete/rgr.fish ~/.config/fish/completions/
        fi
        popd || exit 1
        ;;

    f3d)
        F3D_VERSION="${2:-3.3.0}"
        mkdir -p ~/.config/f3d
        rm -rf ~/.config/f3d/* 2> /dev/null
        pushd ~/.config/f3d || exit 1
        wget "https://github.com/f3d-app/f3d/releases/download/v${F3D_VERSION}/F3D-${F3D_VERSION}-Linux-x86_64.tar.xz"
        tar xf "F3D-${F3D_VERSION}-Linux-x86_64.tar.xz" --strip-components=1
        rm "F3D-${F3D_VERSION}-Linux-x86_64.tar.xz"
        if command -v fish >/dev/null 2>&1; then
            mkdir -p ~/.config/fish/completions
            cp share/fish/vendor_completions.d/f3d.fish ~/.config/fish/completions/
        fi
        popd || exit 1
        ;;

    lua-lsp)
        mkdir -p ~/.config/lua-lsp
        rm -rf ~/.config/lua-lsp/* 2> /dev/null
        pushd ~/.config/lua-lsp || exit 1
        os="linux-x64"
        if [ "$(uname -s)" = "Darwin" ]; then
            os="darwin-arm64"
        fi
        curl -s https://api.github.com/repos/LuaLS/lua-language-server/releases \
            | grep "browser_download_url" \
            | grep "$os.tar.gz" \
            | cut -d":" -f 2,3 \
            | tr -d \" \
            | head -n 1 \
            | wget -i -
        tar xzf lua-language-server-*
        popd || exit 1
        ;;

    luacheck)
        luarocks install luacheck --local
        ;;

    markdown-lsp)
        install_from_github artempyanykh/marksman marksman-linux-x64
        chmod +x marksman-linux-x64
        mv marksman-linux-x64 ~/.local/bin/marksman
        ;;

    hadolint)
        wget https://github.com/hadolint/hadolint/releases/latest/download/hadolint-Linux-x86_64 -O ~/.local/bin/hadolint
        chmod +x ~/.local/bin/hadolint
        ;;

    linters)
        $0 luacheck
        $0 hadolint
        ;;

    lsps)
        $0 lua-lsp
        $0 markdown-lsp
        $0 xml-lsp
        ;;

    localsend)
        TMP_DIR=$(mktemp -d -p /tmp install-XXXXXX)
        pushd "$TMP_DIR" || exit 1
        install_from_github localsend/localsend "LocalSend-.*-linux-x86-64.AppImage"
        chmod +x LocalSend-*.AppImage
        mv LocalSend-*.AppImage ~/.local/bin/localsend
        popd || exit 1
        ;;

    ghostty)
        TMP_DIR=$(mktemp -d -p /tmp install-XXXXXX)
        pushd "$TMP_DIR" || exit 1
        install_from_github pkgforge-dev/ghostty-appimage "Ghostty-.*$arch.AppImage"
        chmod +x Ghostty-*$arch.AppImage
        mv Ghostty-*$arch.AppImage ~/.local/bin/ghostty
        popd || exit 1
        ;;

    wezterm)
        if [ "$(uname -s)" = "Darwin" ]; then
            brew install --cask wezterm@nightly
            exit 0
        fi
        # on x86 you manage ~/.local/bin/wezterm yourself (typically a fork build
        # via wezterm-build), so never overwrite whatever is already there.
        if [ "$arch" = "x86_64" ] && [ -x ~/.local/bin/wezterm ]; then
            info "x86 wezterm already present; leaving it (rm it to reinstall from store)"
            exit 0
        fi
        mkdir -p ~/.local/bin
        install -m755 "$(wezterm_store_path "$arch")" ~/.local/bin/wezterm
        wezterm_finish
        ;;

    wezterm-build)
        [ -x ./build-appimage.sh ] || error "run from wezterm fork root (no ./build-appimage.sh here)"
        branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null) || error "not a git repo"
        [ "$branch" = "juruc" ] || error "wrong branch: '$branch' (expected 'juruc')"

        # default x86 only; `all` cross-builds every arch (needs docker + qemu-user-static)
        platforms="linux/amd64"
        [ "${2:-}" = "all" ] && platforms="linux/amd64 linux/arm64"
        for p in $platforms; do
            PLATFORM="$p" ./build-appimage.sh
        done

        # stage newest AppImage per arch into the store (overrides upstream)
        mkdir -p "$WEZTERM_STORE"
        for a in x86_64 aarch64; do
            f=$(ls -t out/WezTerm-*-"$a".AppImage 2>/dev/null | head -1)
            [ -n "$f" ] && install -m755 "$f" "$WEZTERM_STORE/wezterm-$a"
        done

        # local install = host-arch build (skip if this arch wasn't built)
        if [ -f "$WEZTERM_STORE/wezterm-$arch" ]; then
            install -m755 "$WEZTERM_STORE/wezterm-$arch" ~/.local/bin/wezterm
            wezterm_finish
        else
            warning "no $arch build for local install"
        fi
        ;;

    xml-lsp)
        TMP_DIR=$(mktemp -d -p /tmp install-XXXXXX)
        pushd "$TMP_DIR" || exit 1
        install_from_github redhat-developer/vscode-xml lemminx-linux.zip
        unzip lemminx-linux.zip
        mv lemminx-linux ~/.local/bin/lemminx
        popd || exit 1
        ;;

    rust)
        if ! command -v rustup &> /dev/null; then
            curl --proto '=https' --tlsv1.3 https://sh.rustup.rs -sSf | sh
            source "$HOME/.cargo/env"
            rustup component add rust-analyzer
        else
            rustup update
        fi
        ;;

    gcloud)
        export GCSFUSE_REPO="gcsfuse-$(lsb_release -c -s)"
        echo "deb [signed-by=/usr/share/keyrings/cloud.google.gpg] https://packages.cloud.google.com/apt cloud-sdk main" | sudo tee -a /etc/apt/sources.list.d/google-cloud-sdk.list
        curl https://packages.cloud.google.com/apt/doc/apt-key.gpg | sudo gpg --yes --dearmor -o /usr/share/keyrings/cloud.google.gpg
        sudo apt-get update && sudo apt-get install -y google-cloud-cli
        gcloud init
        gcloud auth application-default login
        ;;

    uv)
        curl -LsSf https://astral.sh/uv/install.sh | sh
        # Autoloaded on first `uv`/`uvx` tab-complete; `>` keeps it idempotent
        # across re-runs (vs appending to config.fish on every install).
        if command -v fish >/dev/null 2>&1; then
            mkdir -p ~/.config/fish/completions
            echo 'uv generate-shell-completion fish | source' > ~/.config/fish/completions/uv.fish
            echo 'uvx --generate-shell-completion fish | source' > ~/.config/fish/completions/uvx.fish
        fi
        ~/.local/bin/uv tool install ty@latest
        ~/.local/bin/uv tool install rerun-sdk@latest
        ~/.local/bin/uv tool install hf@latest
        ~/.local/bin/uv tool install pyrefly
        ~/.local/bin/uv tool install maturin
        ~/.local/bin/uv tool install trackio
        ~/.local/bin/uv tool install py-spy
        ~/.local/bin/rerun analytics disable
        ;;

    pi-code)
        # pi.dev/install.sh does `npm install -g`; force fnm's default node so
        # pi lands in aliases/default/bin (where .xprofile points), not ~/.local
        # or a system node. Run `$0 nodejs <ver>` first.
        if [[ ! -d "$HOME/.local/share/fnm/aliases/default/bin" ]]; then
            error "fnm default node missing. Run '$0 nodejs <version>' first."
        fi
        export PATH="$HOME/.local/share/fnm/aliases/default/bin:$PATH"
        curl -fsSL https://pi.dev/install.sh | sh
        PI_AGENT_DIR="$HOME/myconfigs/pi/.pi/agent"
        curl -fsSL https://raw.githubusercontent.com/earendil-works/pi/main/packages/coding-agent/examples/extensions/permission-gate.ts -o "$PI_AGENT_DIR/extensions/permission-gate.ts"
        curl -fsSL https://raw.githubusercontent.com/earendil-works/pi/main/packages/coding-agent/examples/extensions/protected-paths.ts -o "$PI_AGENT_DIR/extensions/protected-paths.ts"
        curl -fsSL https://raw.githubusercontent.com/earendil-works/pi/main/packages/coding-agent/examples/extensions/notify.ts -o "$PI_AGENT_DIR/extensions/notify.ts"
        curl -fsSL https://raw.githubusercontent.com/mitsuhiko/agent-stuff/main/extensions/uv.ts -o "$PI_AGENT_DIR/extensions/uv.ts"
        curl -fsSL https://raw.githubusercontent.com/mitsuhiko/agent-stuff/main/intercepted-commands/pip -o "$PI_AGENT_DIR/intercepted-commands/pip"
        curl -fsSL https://raw.githubusercontent.com/mitsuhiko/agent-stuff/main/intercepted-commands/pip3 -o "$PI_AGENT_DIR/intercepted-commands/pip3"
        curl -fsSL https://raw.githubusercontent.com/mitsuhiko/agent-stuff/main/intercepted-commands/poetry -o "$PI_AGENT_DIR/intercepted-commands/poetry"
        curl -fsSL https://raw.githubusercontent.com/mitsuhiko/agent-stuff/main/intercepted-commands/python -o "$PI_AGENT_DIR/intercepted-commands/python"
        curl -fsSL https://raw.githubusercontent.com/mitsuhiko/agent-stuff/main/intercepted-commands/python3 -o "$PI_AGENT_DIR/intercepted-commands/python3"
        chmod +x "$PI_AGENT_DIR/intercepted-commands/pip" "$PI_AGENT_DIR/intercepted-commands/pip3" "$PI_AGENT_DIR/intercepted-commands/poetry" "$PI_AGENT_DIR/intercepted-commands/python" "$PI_AGENT_DIR/intercepted-commands/python3"
        ;;

    pixi)
      mkdir -p ~/.local/bin || true
      [[ ! $(command -v pixi) ]] && curl -fsSL https://pixi.sh/install.sh | bash
      if command -v fish >/dev/null 2>&1; then
	      mkdir -p ~/.config/fish/completions
        ~/.pixi/bin/pixi completion --shell fish > ~/.config/fish/completions/pixi.fish
      fi
      ;;

    mujoco)
        TMP_DIR=$(mktemp -d -p /tmp install-XXXXXX)
        pushd "$TMP_DIR" || exit 1
        MUJOCO_VERSION="3.10.0"
        wget https://github.com/google-deepmind/mujoco/releases/download/"$MUJOCO_VERSION"/mujoco-"$MUJOCO_VERSION"-linux-x86_64.tar.gz -O mujoco.tar.gz
        (
          test -d ~/.mujoco && rm -rf ~/.mujoco || true
        ) && mkdir -p ~/.mujoco
        tar xzf mujoco.tar.gz --strip-components 1 -C ~/.mujoco
        ;;

    zig)
        TMP_DIR=$(mktemp -d -p /tmp install-XXXXXX)
        pushd "$TMP_DIR" || exit 1
        wget -O - https://github.com/marler8997/anyzig/releases/latest/download/anyzig-x86_64-linux.tar.gz | tar xz
        mv zig ~/.local/bin/
        install_from_github zigtools/zls zls-x86_64-linux.tar.xz
        tar xf zls-x86_64-linux.tar.xz
        mv zls ~/.local/bin/zls
        popd || exit 1
        ;;

    protoc)
        PROTOC_VERSION="${2:-33.0}"
        TMP_DIR=$(mktemp -d -p /tmp install-XXXXXX)
        pushd "$TMP_DIR" || exit 1
        wget "https://github.com/protocolbuffers/protobuf/releases/download/v${PROTOC_VERSION}/protoc-${PROTOC_VERSION}-linux-x86_64.zip"
        unzip "protoc-${PROTOC_VERSION}-linux-x86_64.zip" -d protoc
        mv protoc/bin/protoc ~/.local/bin/protoc
        chmod +x ~/.local/bin/protoc
        mkdir -p ~/.local/include
        cp -r protoc/include/google ~/.local/include/
        popd || exit 1
        ;;

    gh)
        gh auth login
        gh extension install github/gh-copilot
        gh config set git_protocol ssh
        ;;

    setup-remote)
        if [ $# -lt 2 ]; then
            error "setup-remote requires HOST. Usage: $0 setup-remote <host>"
        fi
        host="$2"

        sync_to_remote "$host"

        $0 remote "$host" wezterm
        $0 remote "$host" minimal
        $0 remote "$host" pixi-utils

        info "Setting up GitHub authentication on $host..."
        if ! gh auth token >/dev/null 2>&1; then
            error "No local gh auth token found. Run 'gh auth login' first."
        fi
        gh auth token | ssh -- "$host" "~/.pixi/bin/gh auth login --with-token && ~/.pixi/bin/gh config set git_protocol ssh"
        info "gh auth configured on $host"

        info "Remote setup complete for $host"
        ;;

    clang-build-analyzer)
        pushd ~/.local/bin
        install_from_github aras-p/ClangBuildAnalyzer ClangBuildAnalyzer-linux
        mv ClangBuildAnalyzer-linux ClangBuildAnalyzer
        chmod +x ClangBuildAnalyzer
        popd || exit 1
        ;;

    install_from_github)
        if [ $# -ne 3 ]; then
            error "install-from-github requires 2 inputs USER/REPO regex"
        fi
        install_from_github "$2" "$3"
        ;;

    setup_platformio)
        pio system completion install fish
        # https://docs.platformio.org/en/stable/core/installation/udev-rules.html#platformio-udev-rules
        curl -fsSL https://raw.githubusercontent.com/platformio/platformio-core/develop/platformio/assets/system/99-platformio-udev.rules | sudo tee /etc/udev/rules.d/99-platformio-udev.rules
        sudo udevadm control --reload-rules && sudo udevadm trigger
        ;;

    setup-fish)
        if [ -d ~/.config/fish ]; then
            backup=~/.config/fish.bak.$(date +%Y%m%d%H%M%S)
            info "Backing up existing fish config to $backup"
            mv ~/.config/fish "$backup"
        fi
        mkdir -p ~/.config/fish/completions

        echo "source ~/myconfigs/fish/config.fish" > ~/.config/fish/config.fish

        # To be able to source bash scripts
        ~/.pixi/bin/fish -c "curl -sL https://git.io/fisher | source && fisher install edc/bass"
        sudo chsh -s ~/.pixi/bin/fish $USER
        ;;

    unstow)
        pushd ~/myconfigs || exit 1
        stow --target ~ --ignore=.mypy_cache --ignore=.ruff_cache --delete cargo \
                                                                           clangd \
                                                                           i3 \
                                                                           xsession \
                                                                           git \
                                                                           neovim \
                                                                           scripts \
                                                                           stylua \
                                                                           tmux \
                                                                           fd \
                                                                           ripgrep \
                                                                           wezterm \
                                                                           yamllint \
                                                                           zathura
        popd || exit 1
        ;;

    stow)
        pixi_path=${PIXI_PATH:-$HOME/.pixi}
        pushd ~/myconfigs || exit 1
        $pixi_path/bin/stow --no-folding --target ~ --ignore=.mypy_cache --ignore=.ruff_cache --stow cargo \
                                                                                      clangd \
                                                                                      git \
                                                                                      scripts \
                                                                                      stylua \
                                                                                      fd \
                                                                                      ripgrep \
                                                                                      yamllint \
                                                                                      zathura \
                                                                                      nextcloud
        mkdir -p "$HOME/.claude"
        $pixi_path/bin/stow --target ~ --ignore=.mypy_cache --ignore=.ruff_cache --stow i3 \
                                                                         xsession \
                                                                         wezterm \
                                                                         neovim \
                                                                         tmux \
                                                                         claude \
                                                                         pi \
                                                                         flameshot

        mkdir -p "$HOME/.claude-work"
        for resource in CLAUDE.md agents commands skills; do
            if [[ -e "$HOME/.claude-work/$resource" || -L "$HOME/.claude-work/$resource" ]]; then
                [[ "$HOME/.claude/$resource" -ef "$HOME/.claude-work/$resource" ]] \
                    || error "~/.claude-work/$resource already exists."
            else
                ln -s "$HOME/.claude/$resource" "$HOME/.claude-work/$resource"
            fi
        done
        popd || exit 1
        ;;

    urdf_viz)
        install_package rospack-tools
