        ;;

    pixi-utils)
        info "Installing utility tools..."
        pixi global install gh jless difftastic numbat # yt-dlp
        ;;

    pixi-all)
        info "Installing all pixi global packages..."
        $0 pixi-core
        $0 pixi-devtools
        $0 pixi-build-rust
        $0 pixi-debug-profile
        $0 pixi-network-remote
        $0 pixi-utils
        info "Done!"
        ;;

    gimp)
        TMP_DIR=$(mktemp -d -p /tmp install-XXXXXX)
        pushd "$TMP_DIR" || exit 1
        GIMP_MAJOR=$(curl -sL https://download.gimp.org/gimp/ | grep -oP 'href="\Kv[0-9]+\.[0-9]+' | sort -V | tail -1)
        GIMP_VERSION=$(curl -sL "https://download.gimp.org/gimp/${GIMP_MAJOR}/linux/" | grep -oP 'GIMP-\K[0-9]+\.[0-9]+\.[0-9]+(?=-x86_64\.AppImage)' | grep -v RC | sort -V | tail -1)
        if [ "$arch_name" = "arm64" ]; then
            wget "https://download.gimp.org/gimp/${GIMP_MAJOR}/linux/GIMP-${GIMP_VERSION}-aarch64.AppImage" -O ~/.local/bin/gimp
        else
            wget "https://download.gimp.org/gimp/${GIMP_MAJOR}/linux/GIMP-${GIMP_VERSION}-x86_64.AppImage" -O ~/.local/bin/gimp
        fi
        chmod +x ~/.local/bin/gimp
        popd || exit 1
        ;;

    --help)
        list_options
        ;;

    *)
        info "Usage: $(basename "$0") <option>" >&2
        info "Available options:"
        list_options
        exit 1
        ;;
