{
  "categories": {
    "correctness": "error",
    "pedantic": "warn",
    "perf": "warn",
    "suspicious": "warn"
  },
  "env": {
    "builtin": true,
    "node": true
  },
  "plugins": [
    "eslint",
    "typescript",
    "unicorn",
    "oxc",
    "import",
    "promise",
    "node"
  ],
  "rules": {
    "complexity": [
      "error",
      {
        "max": 45
      }
    ],
    "promise/no-callback-in-promise": "off"
  }
}
