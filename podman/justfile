# Static, musl-linked podman + full runtime stack.
#
#   just build              # build v6.1.0 -> out/podman-static-v6.1.0-linux-amd64.tar.gz
#   just build v6.1.0       # build a specific version
#   just install            # extract into ~/.local, write ~/.config/containers, wrap podman, register generator
#   just uninstall          # remove wrapper, configs, generator, prefix, storage (keeps policy.json)
#   just clean              # remove ./out
#
#   ENGINE=podman just build          # build with rootless podman instead of docker
#   PLATFORM=linux/arm64 just build   # cross-build (needs qemu binfmt; slow under emulation)

VERSION := "v6.1.0"
ENGINE  := env("ENGINE", "docker")
PREFIX  := "~/.local/lib/podman-static"

_default:
    @just --list

# Build the static stack tarball into ./out (writes nothing outside ./out).
build version=VERSION:
    #!/usr/bin/env bash
    set -euo pipefail
    export DOCKER_BUILDKIT=1
    plat=()
    [ -n "${PLATFORM:-}" ] && plat=(--platform "$PLATFORM")
    {{ENGINE}} build \
        --target export \
        --output out \
        --build-arg PODMAN_VERSION={{version}} \
        "${plat[@]}" \
        -f Containerfile \
        .
    echo "==> built:"; ls -1 out/*.tar.gz

# Install into a private prefix + wrap ~/.local/bin/podman (isolated from any other podman).
install version=VERSION prefix=PREFIX:
    #!/usr/bin/env bash
    set -euo pipefail
    arch="$(uname -m | sed 's/x86_64/amd64/; s/aarch64/arm64/')"
    tarball="out/podman-static-{{version}}-linux-${arch}.tar.gz"
    [ -f "$tarball" ] || { echo "missing $tarball — run: just build {{version}}" >&2; exit 1; }

    prefix="{{prefix}}"; prefix="${prefix/#\~/$HOME}"
    root="$prefix/usr/local"
    conf="$prefix/etc/containers"          # tarball ships policy.json here
    xdg="$HOME/.config/containers"         # podman reads config from here by default
    # Storage outside the prefix: container overlay dirs are sub-UID-owned (rm -rf on reinstall
    # can't touch them), and this way images survive upgrades.
    data="$HOME/.local/share/podman-static"

    rm -rf "$prefix"; mkdir -p "$prefix"
    tar xzf "$tarball" -C "$prefix"   # -> $prefix/usr/local/... , $prefix/etc/containers/...

    # Config in the standard XDG path so every podman call — including transient
    # health-check services — finds it without CONTAINERS_* env. Replace the known
    # dangling symlinks left by an older layout.
    mkdir -p "$xdg"
    [ -L "$xdg/containers.conf" ] && rm -f "$xdg/containers.conf"
    [ -L "$xdg/registries.conf" ] && rm -f "$xdg/registries.conf"

    # Only the paths podman can't guess for a relocated prefix (the rest are built-in
    # defaults). bin is in helper_binaries_dir so pasta is found here, not via PATH.
    cat > "$xdg/containers.conf" <<EOF
    [engine]
    conmon_path = ["$root/lib/podman/conmon"]
    helper_binaries_dir = ["$root/lib/podman", "$root/libexec/podman", "$root/bin"]

    [engine.runtimes]
    crun = ["$root/bin/crun"]
    runc = ["$root/bin/runc"]
    EOF

    # Isolated storage (own graphroot). No mount_program: podman keeps its default
    # native-or-fuse decision; on this kernel it falls back to the bundled
    # fuse-overlayfs, found on PATH via the wrapper below.
    cat > "$xdg/storage.conf" <<EOF
    [storage]
    driver = "overlay"
    graphroot = "$data/storage"
    EOF

    # Entry point: the only job is putting the bundle's bin on PATH so podman can
    # find fuse-overlayfs. Config is discovered from $xdg — no CONTAINERS_* env.
    mkdir -p "$HOME/.local/bin"
    cat > "$HOME/.local/bin/podman" <<EOF
    #!/bin/sh
    # static podman {{version}} — generated by 'just install'
    root="$root"
    export PATH="\$root/bin:\$PATH"
    exec "\$root/bin/podman" "\$@"
    EOF
    chmod +x "$HOME/.local/bin/podman"

    # Rootless Quadlet generator: systemd has no HOME-local generator dir in its
    # default search path, so register the bundled generator and point the user
    # manager at it. %h expands per-user at generator time.
    gendir="$HOME/.local/lib/systemd/user-generators"
    mkdir -p "$gendir"
    ln -sfn "$root/libexec/podman/quadlet" "$gendir/podman-user-generator"
    dropin="$HOME/.config/systemd/user.conf.d"
    mkdir -p "$dropin"
    cat > "$dropin/podman-static.conf" <<EOF
    [Manager]
    ManagerEnvironment="PODMAN=%h/.local/bin/podman" "SYSTEMD_GENERATOR_PATH=%h/.local/lib/systemd/user-generators:"
    EOF
    # Drop the older whole-file user.conf if it only carried our generator env.
    if [ -f "$HOME/.config/systemd/user.conf" ] \
       && grep -q 'user-generators' "$HOME/.config/systemd/user.conf"; then
        rm -f "$HOME/.config/systemd/user.conf"
        echo "removed superseded ~/.config/systemd/user.conf"
    fi
    systemctl --user daemon-reexec
    systemctl --user daemon-reload
    echo "==> registered rootless quadlet generator (user manager reloaded)"

    # policy.json has no env override; install non-clobbering (image pulls need it).
    mkdir -p "$HOME/.config/containers"
    if [ ! -e "$HOME/.config/containers/policy.json" ]; then
        cp "$conf/policy.json" "$HOME/.config/containers/policy.json"
        echo "installed ~/.config/containers/policy.json"
    else
        echo "kept existing ~/.config/containers/policy.json"
    fi

    echo "==> installed static podman {{version}} -> $HOME/.local/bin/podman (prefix: $prefix)"
    "$HOME/.local/bin/podman" --version

    # fish completions for the podman command (fish auto-loads ~/.config/fish/completions).
    comp="$root/share/fish/vendor_completions.d/podman.fish"
    if [ -f "$comp" ]; then
        install -Dm644 "$comp" "$HOME/.config/fish/completions/podman.fish"
        echo "==> installed fish completions -> ~/.config/fish/completions/podman.fish"
    fi

    # podman-compose (Python): installed isolated via uv, not in the tarball; podman finds it on PATH.
    if command -v uv >/dev/null 2>&1; then
        uv tool install -q podman-compose
        echo "==> installed podman-compose -> $HOME/.local/bin/podman-compose"
    else
        echo "!! podman-compose skipped: install 'uv' first, then: uv tool install podman-compose" >&2
    fi

# Remove wrapper, prefix, and storage (leaves shared ~/.config/containers/policy.json).
uninstall prefix=PREFIX:
    #!/usr/bin/env bash
    set -euo pipefail
    prefix="{{prefix}}"; prefix="${prefix/#\~/$HOME}"
    data="$HOME/.local/share/podman-static"
    # Rootless storage is sub-UID-owned; only the userns can delete it (via the wrapper).
    [ -x "$HOME/.local/bin/podman" ] && "$HOME/.local/bin/podman" unshare rm -rf "$data" 2>/dev/null || true
    rm -f "$HOME/.local/bin/podman" "$HOME/.config/fish/completions/podman.fish"
    # Only the config this installer owns; policy.json and systemd/ quadlets are shared.
    rm -f "$HOME/.config/containers/containers.conf" "$HOME/.config/containers/storage.conf"
    rm -f "$HOME/.local/lib/systemd/user-generators/podman-user-generator"
    rm -f "$HOME/.config/systemd/user.conf.d/podman-static.conf"
    systemctl --user daemon-reload 2>/dev/null || true
    rm -rf "$prefix"
    rm -rf "$data" 2>/dev/null || true
    if command -v uv >/dev/null 2>&1; then uv tool uninstall podman-compose 2>/dev/null || true; fi
    echo "==> removed static podman, configs, generator, storage, fish completions (and podman-compose if uv installed it)"

# Remove build outputs.
clean:
    rm -rf out
